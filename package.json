{
  "name": "aid",
  "version": "0.0.0",
  "private": true,
  "description": "Single-binary documentation generator for markdown, HTML, OpenAPI, and Protobuf — with unified Tailwind theming, cross-format search, and LLM-ready exports.",
  "type": "module",
  "bin": {
    "aid": "./src/cli/index.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "scripts/compile.ts",
    "emit-schema": "bun run scripts/emit-schema.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fmt": "biome format --write ."
  },
  "engines": {
    "bun": ">=1.3.6"
  },
  "dependencies": {
    "@aid/proto-ui": "workspace:*",
    "@biomejs/js-api": "^4.0.0",
    "@biomejs/wasm-nodejs": "^2.4.15",
    "@bufbuild/buf": "^1.69.0",
    "@scalar/api-reference": "^1.55.3",
    "@scalar/openapi-parser": "^0.28.2",
    "@shikijs/rehype": "^4.0.2",
    "@stoplight/spectral-core": "^1.22.0",
    "@stoplight/spectral-parsers": "^1.0.5",
    "@stoplight/spectral-rulesets": "^1.22.1",
    "@tailwindcss/node": "^4.3.0",
    "@tailwindcss/oxide": "^4.3.0",
    "citty": "^0.2.2",
    "markdownlint": "^0.41.1",
    "mermaid": "^11.14.0",
    "minisearch": "^7",
    "react": "^19",
    "react-dom": "^19",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "shiki": "^4.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@bufbuild/buf-darwin-arm64": "1.69.0",
    "@bufbuild/buf-darwin-x64": "1.69.0",
    "@bufbuild/buf-linux-aarch64": "1.69.0",
    "@bufbuild/buf-linux-x64": "1.69.0",
    "@tailwindcss/oxide-darwin-arm64": "4.3.0",
    "@tailwindcss/oxide-darwin-x64": "4.3.0",
    "@tailwindcss/oxide-linux-arm64-gnu": "4.3.0",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.0",
    "@types/bun": "^1.3.13",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "overrides": {
    "jsonc-parser": "3.3.1"
  },
  "patchedDependencies": {
    "jsonc-parser@3.3.1": "patches/jsonc-parser@3.3.1.patch"
  }
}
