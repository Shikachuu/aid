{
  "name": "aid",
  "version": "0.0.0",
  "private": true,
  "description": "Single-binary documentation generator for markdown, HTML, OpenAPI, and Protobuf — with unified Tailwind theming, cross-format search, and LLM-ready exports.",
  "type": "module",
  "bin": {
    "aid": "./src/cli/index.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "scripts/compile.ts",
    "emit-schema": "bun run scripts/emit-schema.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "bun lint --no-script src scripts tests packages && bun src/cli/index.ts lint . --filter css",
    "fmt": "bun fmt --no-script \"{src,scripts,tests,packages,site}/**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}\" \"*.json\"",
    "gen-docs": "bun run scripts/gen-docs.ts",
    "gen-css-data": "bun run scripts/gen-css-data.ts",
    "gen-bunfig": "bun run scripts/gen-bunfig.ts",
    "docs:build": "bun src/cli/index.ts build site --clean",
    "docs:dev": "bun src/cli/index.ts dev site",
    "docs:lint": "bun src/cli/index.ts lint site --filter md",
    "docs:affected": "bun run scripts/docs-affected.ts",
    "deps:binaries": "bun run scripts/check-binaries.ts"
  },
  "engines": {
    "bun": ">=1.3.6"
  },
  "dependencies": {
    "@aid/proto-ui": "workspace:*",
    "@bufbuild/buf": "^1.75.0",
    "@scalar/api-reference": "^1.76.4",
    "@scalar/openapi-parser": "^0.29.19",
    "@shikijs/rehype": "^4.6.0",
    "@stoplight/spectral-core": "^1.24.0",
    "@stoplight/spectral-parsers": "^1.0.5",
    "@stoplight/spectral-rulesets": "^1.23.0",
    "@tailwindcss/node": "^4.3.4",
    "@tailwindcss/oxide": "^4.3.4",
    "citty": "^0.2.2",
    "lightningcss": "1.33.0",
    "markdownlint": "^0.42.0",
    "mermaid": "^12.3.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "shiki": "^4.6.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vfile": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bufbuild/buf-darwin-arm64": "1.75.0",
    "@bufbuild/buf-darwin-x64": "1.75.0",
    "@bufbuild/buf-linux-aarch64": "1.75.0",
    "@bufbuild/buf-linux-x64": "1.75.0",
    "@oven/bun-darwin-aarch64": "1.4.4-canary.20261103.1",
    "@oven/bun-darwin-x64": "1.4.4-canary.20261103.1",
    "@oven/bun-linux-aarch64": "1.4.4-canary.20261103.1",
    "@oven/bun-linux-x64": "1.4.4-canary.20261103.1",
    "@tailwindcss/oxide-darwin-arm64": "4.3.4",
    "@tailwindcss/oxide-darwin-x64": "4.3.4",
    "@tailwindcss/oxide-linux-arm64-gnu": "4.3.4",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.4",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@webref/css": "^8.7.8",
    "@webref/elements": "^2.9.2",
    "typescript": "^7.0.2"
  }
}
