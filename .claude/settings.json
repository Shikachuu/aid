{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run *)",
      "Bash(bun lint *)",
      "Bash(bun fmt *)",
      "Bash(bun test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(rg *)",
      "Bash(jq *)",
      "mcp__codebase-memory-mcp__search_graph",
      "mcp__codebase-memory-mcp__query_graph",
      "mcp__codebase-memory-mcp__trace_path",
      "mcp__codebase-memory-mcp__get_code_snippet",
      "mcp__codebase-memory-mcp__get_file_outline",
      "mcp__codebase-memory-mcp__get_graph_schema",
      "mcp__codebase-memory-mcp__compare_graphs",
      "mcp__codebase-memory-mcp__get_architecture",
      "mcp__codebase-memory-mcp__search_code",
      "mcp__codebase-memory-mcp__list_projects",
      "mcp__codebase-memory-mcp__index_status",
      "mcp__codebase-memory-mcp__check_index_coverage",
      "mcp__codebase-memory-mcp__detect_changes",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MISE_AUTO_INSTALL=0 mise exec -C \"$CLAUDE_PROJECT_DIR\" -- codebase-memory-mcp hook-augment || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "MISE_AUTO_INSTALL=0 mise exec -C \"$CLAUDE_PROJECT_DIR\" -- codebase-memory-mcp hook-augment || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "MISE_AUTO_INSTALL=0 mise exec -C \"$CLAUDE_PROJECT_DIR\" -- codebase-memory-mcp hook-augment || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.sh\""
          }
        ]
      },
      {
        "matcher": "Read|mcp__.*codebase-memory-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "MISE_AUTO_INSTALL=0 mise exec -C \"$CLAUDE_PROJECT_DIR\" -- codebase-memory-mcp hook-augment || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
