{
  "name": "@aid/proto-ui",
  "version": "0.0.1",
  "description": "Embeddable React component for browsing .proto files. Standalone proto documentation UI used by aid and consumable by any React app.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hydrate": {
      "bun": "./src/hydrate.tsx",
      "types": "./dist/hydrate.d.ts",
      "import": "./dist/hydrate.js"
    },
    "./parser": {
      "bun": "./src/parser.ts",
      "types": "./dist/parser.d.ts",
      "import": "./dist/parser.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "marked": "^16",
    "protobufjs": "^8.2.0"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.0",
    "@tailwindcss/oxide": "^4.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "^7.0.0-dev.20260514.1",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.3.0",
    "typescript": "^5"
  }
}
