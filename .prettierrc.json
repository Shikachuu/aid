{
  "printWidth": 100,
  "semi": false,
  "plugins": [
    "prettier-plugin-tailwindcss"
  ],
  "tailwindStylesheet": "./src/theme/main.css",
  "tailwindFunctions": [
    "clsx",
    "cn",
    "tw",
    "twMerge",
    "cva"
